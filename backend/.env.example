# Copia este archivo como .env y cambia los valores. El archivo .env NO se sube a git.

# --- MySQL (docker-compose.yml) ---
MYSQL_USER=aquasample
MYSQL_PASSWORD=cambia_esta_clave
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
# Puerto del PC donde se expone MySQL (cámbialo si el 3306 ya está ocupado)
MYSQL_PORT=3306

# --- Backend Spring Boot (application.properties) ---
DB_URL=jdbc:mysql://localhost:3306/aquasample
DB_USER=aquasample
DB_PASSWORD=cambia_esta_clave
